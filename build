#!/usr/bin/env bash
set -u

case "${1:-}" in
    --test|--debug)
        nix develop -c zig build -Doptimize=Debug
        ;;
    *)
        nix build
        mkdir -p zig-out/bin
        cp -f result/bin/mandelbrot zig-out/bin/mandelbrot
        echo "Built: zig-out/bin/mandelbrot"
        ;;
esac
